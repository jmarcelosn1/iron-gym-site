{
  "name": "iron-gym",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/finalize-dist.mjs",
    "assets": "node scripts/build-assets.mjs && node scripts/build-personagens.mjs && node scripts/build-abertura.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "serve": "node scripts/serve-dist.mjs --open",
    "qa": "node scripts/qa.mjs",
    "qa:responsivo": "node scripts/qa-responsivo.mjs",
    "qa:acessibilidade": "node scripts/qa-acessibilidade.mjs && node scripts/qa-contraste.mjs",
    "personagens": "node scripts/build-personagens.mjs",
    "qa:capturas": "node scripts/capturas.mjs",
    "deploy": "npm run build && wrangler deploy",
    "abertura": "node scripts/build-abertura.mjs"
  },
  "dependencies": {
    "@fontsource/host-grotesk": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.143.1"
  }
}
